{:paths ["src"]
 ;; The decision ledger: langchain.db is the index and the Datalog engine,
 ;; journal is the append-only history, langchain.persist is the seam. Policy
 ;; evaluation and CACAO capability verification stay behind ports (see
 ;; authorization.ports), so those engines are still the host's to supply --
 ;; this repo depends on how decisions are kept, not on who makes them.
 ;;
 ;; langchain is pinned at schema-from-tx-data, which authorization.schema
 ;; needs to express one canonical schema in both dialects.
 :deps {
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn {:git/sha "79dba32c8892058842c57783f06a2dfe4601aeb0"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}io.github.kotoba-lang/langchain
        {:git/sha "8789fe4cc387f294b6936f2171e419a252fd9ea8"}
        io.github.kotoba-lang/journal
        {:git/sha "4ee86a07c162cf46707232fa70a720f989989486"}}
 :aliases {:test {:extra-paths ["test"]
                  :extra-deps {io.github.cognitect-labs/test-runner
                               {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
                  :main-opts ["-m" "cognitect.test-runner"]
                  :exec-fn cognitect.test-runner.api/test}}}
